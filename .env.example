# Vorlage für die Umgebungsvariablen des Backends.
# Kopieren nach `.env` (oder in der Shell exportieren) und anpassen.

# JWT_SECRET hat bewusst KEINEN Standardwert und wird nie als Literal im
# Repository gespeichert. Einmal erzeugen und über Neustarts hinweg beibehalten:
#
#   python -c "import secrets; print(secrets.token_hex(32))"
#
JWT_SECRET=

DATABASE_URL=sqlite:///./dev.db
JWT_EXPIRES_MINUTES=60
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE=5242880
CORS_ORIGIN=http://localhost:5173
